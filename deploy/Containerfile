# Firefly III built from this branch onto serversideup/php's Alpine fpm-nginx image.
#
# Upstream's image (fireflyiii/core) is built on serversideup/php's Debian fpm-nginx image, so this
# runs the same entrypoint, nginx and php-fpm setup and takes the same PHP_* and NGINX_* settings.
# PHP comes from the base image, which serversideup republishes for every PHP patch release, so a
# PHP security fix is a rebuild with --pull=always rather than a wait for a Firefly III release.
#
#   podman build --pull=always --format docker -f deploy/Containerfile \
#     --build-arg REVISION=$(git rev-parse HEAD) -t localhost/firefly-iii:patched .
#
# --format docker keeps the HEALTHCHECK; the OCI format silently drops it.

ARG PHP_IMAGE=docker.io/serversideup/php:8.5-fpm-nginx-alpine
ARG NODE_IMAGE=docker.io/library/node:24-alpine
# The release whose v3 translations and security alerts are copied in: both are generated by
# upstream's release workflow and are not in git. Bump it with each rebase onto a new release.
ARG RELEASE_IMAGE=docker.io/fireflyiii/core:version-6.7.9@sha256:4409f9f0f87378ba95d40811352f4f49338d276bb638c1e6d18a5579f332fbe8

FROM ${RELEASE_IMAGE} AS release

# The v3 frontend, built as the release workflow builds it.
FROM ${NODE_IMAGE} AS assets
WORKDIR /src
COPY package.json package-lock.json ./
COPY resources/assets/v3/package.json resources/assets/v3/
RUN npm ci --no-audit --no-fund
COPY resources/assets/v3 resources/assets/v3
RUN npm run build --workspace=v3

# PHP with the extensions upstream's image adds to serversideup's defaults, and bash for its scripts.
FROM ${PHP_IMAGE} AS php
USER root
RUN install-php-extensions intl bcmath memcached sockets \
 && apk add --no-cache bash
USER www-data

FROM php AS vendor
WORKDIR /var/www/html
COPY --chown=www-data:www-data composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --no-interaction --no-progress

FROM php
ARG REVISION=unknown
ARG ISODATE=unknown

# Upstream's settings where they differ from serversideup's.
ENV FIREFLY_III_PATH=/var/www/html \
    PHP_ERROR_REPORTING=24575 \
    PHP_MAX_EXECUTION_TIME=300 \
    PHP_OPCACHE_ENABLE=1 \
    SHOW_WELCOME_MESSAGE=false \
    GITREVISION=${REVISION} \
    ISODATE=${ISODATE}

LABEL org.opencontainers.image.title="Firefly III (patched)" \
      org.opencontainers.image.source="https://git.484838.xyz/Home/firefly-iii" \
      org.opencontainers.image.url="https://git.484838.xyz/Home/firefly-iii/src/branch/patched/6.7.6" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.description="Firefly III 6.7.9 with per-journal stop processing for applied rule groups, attachments on the account all-transactions list, every chart label, a reconciled column on account lists, running balances in their own currency, balances shown from the user's side, subscription amounts on one line and without repeats, due dates drawn on the account charts, a projected total on the dashboard accounts chart, a page to review what was created after a cut-off, bulk changes to source and destination accounts, pruning of empty new expense and revenue accounts, a subscription column on transaction lists, and each transaction's upfirefly mail address. Built from https://git.484838.xyz/Home/firefly-iii (branch patched/6.7.6)."

# Upstream's startup scripts: create the storage directories, wait for the database, then migrate
# and upgrade it. serversideup's entrypoint runs everything in /etc/entrypoint.d.
COPY --chmod=755 deploy/scripts/wait-for-it.sh deploy/scripts/finalize-image.sh deploy/scripts/entrypoint.sh /usr/local/bin/
COPY --chmod=755 deploy/scripts/11-execute-things.sh /etc/entrypoint.d/11-execute-things.sh

WORKDIR /var/www/html
COPY --chown=www-data:www-data . .
COPY --from=vendor --chown=www-data:www-data /var/www/html/vendor vendor
COPY --from=assets --chown=www-data:www-data /src/public/build public/build
COPY --from=release --chown=www-data:www-data /var/www/html/public/v3/i18n public/v3/i18n
COPY --from=release --chown=www-data:www-data /var/www/html/resources/alerts.json resources/alerts.json

# Static v1 assets are served immutable for a year and versioned by build_time, so a patched file
# would never reach a browser that has the old one. Stamp each build with its own time.
# package:discover won't boot without an app key; the throwaway one here isn't kept in the image.
RUN sed -i -E "s/^'build_time' => [0-9]+,/'build_time' => $(date +%s),/" config/firefly.php \
 && grep -q "^'build_time' => $(date +%s | cut -c1-6)" config/firefly.php \
 && composer dump-autoload --optimize --no-dev --no-interaction \
 && APP_KEY="base64:$(head -c 32 /dev/urandom | base64)" php artisan package:discover \
 && echo "${REVISION}" > /var/www/counter-main.txt \
 && echo "${ISODATE}" > /var/www/build-date-main.txt \
 && chmod -R 775 storage

VOLUME /var/www/html/storage/upload
HEALTHCHECK --start-period=5m --interval=5s --timeout=3s --retries=3 \
    CMD sh -c 'curl --insecure --silent --location --show-error --fail http://localhost:${NGINX_HTTP_PORT}${HEALTHCHECK_PATH} || exit 1'
