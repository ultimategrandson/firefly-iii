# Firefly III with local patches layered onto the official release image.
#
# Only the patched source files are copied in, so everything else (PHP, extensions, nginx,
# vendor/, the entrypoint) is exactly what upstream ships. Bump BASE to the next release's digest
# and rebuild; check the copied files still apply against that release first.
#
#   podman build --format docker -f deploy/Containerfile \
#     --build-arg REVISION=$(git rev-parse HEAD) -t git.484838.xyz/home/firefly-iii:6.7.6-patched .
#   podman push git.484838.xyz/home/firefly-iii:6.7.6-patched
#
# --format docker keeps the base image's HEALTHCHECK; the OCI format silently drops it.

ARG BASE=docker.io/fireflyiii/core:version-6.7.6@sha256:1ddb762382b9e04270ca68dc0ba73291ed24e8701ec423f267bfcde7ad7ecf27
FROM ${BASE}
ARG REVISION=unknown

LABEL org.opencontainers.image.title="Firefly III (patched)" \
      org.opencontainers.image.source="https://git.484838.xyz/Home/firefly-iii" \
      org.opencontainers.image.url="https://git.484838.xyz/Home/firefly-iii/src/branch/patched/6.7.6" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.description="Firefly III 6.7.6 with per-journal stop processing for applied rule groups, budgets on the account all-transactions list, every chart label, a reconciled column on account lists, running balances in their own currency, balances shown from the user's side, subscription amounts on one line and without repeats, due dates drawn on the account charts, a projected total on the dashboard accounts chart, a page to review what was created after a cut-off, bulk changes to source and destination accounts, pruning of empty new expense and revenue accounts, a subscription column on transaction lists, and each transaction's upfirefly mail address. Built from https://git.484838.xyz/Home/firefly-iii (branch patched/6.7.6)."

# Applying a rule group honours "stop processing" per journal.
COPY --chown=www-data:www-data app/TransactionRules/Engine/SearchRuleEngine.php /var/www/html/app/TransactionRules/Engine/SearchRuleEngine.php
COPY --chown=www-data:www-data app/Http/Controllers/RuleGroup/ExecutionController.php /var/www/html/app/Http/Controllers/RuleGroup/ExecutionController.php
COPY --chown=www-data:www-data app/Api/V1/Controllers/Models/RuleGroup/TriggerController.php /var/www/html/app/Api/V1/Controllers/Models/RuleGroup/TriggerController.php

# An account's "all transactions" list fills the budget, bill and attachment columns.
COPY --chown=www-data:www-data app/Http/Controllers/Account/ShowController.php /var/www/html/app/Http/Controllers/Account/ShowController.php

# Chart x-axes show every label, rotated if need be, instead of skipping every second one.
COPY --chown=www-data:www-data public/v1/js/ff/charts.defaults.js /var/www/html/public/v1/js/ff/charts.defaults.js

# Account lists show whether every transaction on the account is reconciled. The v3 page script is
# bundled by Vite, so the whole rebuilt public/build replaces the release's (only the accounts
# index chunk and the manifest differ).
COPY --chown=www-data:www-data app/Support/JsonApi/Enrichments/AccountEnrichment.php /var/www/html/app/Support/JsonApi/Enrichments/AccountEnrichment.php
COPY --chown=www-data:www-data app/Transformers/AccountTransformer.php /var/www/html/app/Transformers/AccountTransformer.php
COPY --chown=www-data:www-data resources/views/accounts/index.blade.php /var/www/html/resources/views/accounts/index.blade.php
COPY --chown=www-data:www-data resources/lang/en_US/list.php /var/www/html/resources/lang/en_US/list.php
COPY --chown=www-data:www-data public/build/ /var/www/html/public/build/

# Running balances show in the account's own currency (a cash deposit no longer falls back to the
# primary currency) and carry the approximate primary-currency figure, as amounts do.
COPY --chown=www-data:www-data app/View/Components/Elements/TransactionRunningBalance.php /var/www/html/app/View/Components/Elements/TransactionRunningBalance.php
COPY --chown=www-data:www-data resources/views/components/elements/transaction-running-balance.blade.php /var/www/html/resources/views/components/elements/transaction-running-balance.blade.php
COPY --chown=www-data:www-data resources/views/components/lists/groups-large.blade.php /var/www/html/resources/views/components/lists/groups-large.blade.php

# Balances are shown from the user's side: revenue as a gain, a debt owed as negative. The list's
# half is in the rebuilt public/build above; the running balance component is copied above too.
COPY --chown=www-data:www-data resources/views/accounts/show.blade.php /var/www/html/resources/views/accounts/show.blade.php

# Subscription amounts stay on one line, a fixed amount is shown without "~" or a repeated
# primary-currency figure, and sums name their currency (by code) only when there are several.
COPY --chown=www-data:www-data resources/views/components/lists/subscriptions.blade.php /var/www/html/resources/views/components/lists/subscriptions.blade.php

# Transaction due dates are drawn as lines on the dashboard and account charts. The dashboard half is
# in the rebuilt public/build above, and the account page view is copied above too.
COPY --chown=www-data:www-data app/Http/Controllers/Chart/DueDateController.php /var/www/html/app/Http/Controllers/Chart/DueDateController.php
COPY --chown=www-data:www-data routes/web.php /var/www/html/routes/web.php
COPY --chown=www-data:www-data resources/lang/en_US/firefly.php /var/www/html/resources/lang/en_US/firefly.php
COPY --chown=www-data:www-data public/v1/js/ff/charts.js /var/www/html/public/v1/js/ff/charts.js

# The dashboard accounts chart has a projected total line. The routes and translations are copied
# above, and the chart half is in the rebuilt public/build.
COPY --chown=www-data:www-data app/Http/Controllers/Chart/ProjectionController.php /var/www/html/app/Http/Controllers/Chart/ProjectionController.php

# A review page lists the transactions and expense and revenue accounts created after a cut-off, and
# deletes the new accounts left empty. Bulk edit can change source and destination accounts; its page
# script is in the rebuilt public/build, and the routes and translations are copied above.
COPY --chown=www-data:www-data app/Http/Controllers/Transaction/ReviewController.php /var/www/html/app/Http/Controllers/Transaction/ReviewController.php
COPY --chown=www-data:www-data app/Http/Controllers/Transaction/BulkController.php /var/www/html/app/Http/Controllers/Transaction/BulkController.php
COPY --chown=www-data:www-data resources/views/transactions/review.blade.php /var/www/html/resources/views/transactions/review.blade.php
COPY --chown=www-data:www-data resources/views/transactions/bulk/edit.blade.php /var/www/html/resources/views/transactions/bulk/edit.blade.php
COPY --chown=www-data:www-data resources/views/components/layout/sidebar.blade.php /var/www/html/resources/views/components/layout/sidebar.blade.php
COPY --chown=www-data:www-data routes/breadcrumbs.php /var/www/html/routes/breadcrumbs.php

# Transaction lists that show a category or budget also show the subscription. The list view is copied above.
COPY --chown=www-data:www-data app/View/Components/Lists/GroupsLarge.php /var/www/html/app/View/Components/Lists/GroupsLarge.php

# A transaction's page shows its upfirefly mail address, with a copy button, when TRANSACTION_MAIL_KEY
# and TRANSACTION_MAIL_ADDRESS are set. The translations are copied above.
COPY --chown=www-data:www-data app/Support/TransactionMailAddress.php /var/www/html/app/Support/TransactionMailAddress.php
COPY --chown=www-data:www-data config/transaction_mail.php /var/www/html/config/transaction_mail.php
COPY --chown=www-data:www-data app/Http/Controllers/Transaction/ShowController.php /var/www/html/app/Http/Controllers/Transaction/ShowController.php
COPY --chown=www-data:www-data resources/views/transactions/show.blade.php /var/www/html/resources/views/transactions/show.blade.php

# Static v1 assets are served immutable for a year and versioned by build_time, so a patched file
# would never reach a browser that has the old one. Stamp each build with its own time.
RUN sed -i -E "s/^'build_time' => [0-9]+,/'build_time' => $(date +%s),/" /var/www/html/config/firefly.php \
 && grep -q "^'build_time' => $(date +%s | cut -c1-6)" /var/www/html/config/firefly.php
